---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "شاغر اليوم | شاليهات متاحة الآن",
  description = "استعرض الشاليهات المتاحة للحجز الفوري اليوم. ابحث، قارن، واحجز مباشرة مع المالك.",
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=3" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-content">
        <div class="logo">
          <span class="text-h2">شاغر اليوم ⚡️</span>
        </div>
        <nav>
          <a href="/" class="nav-link">الرئيسية</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer text-muted">
      <div class="container footer-content">
        <div class="footer-links">
          <a href="/faq">الأسئلة الشائعة</a>
          <a href="/terms">شروط الاستخدام</a>
          <a href="/privacy">سياسة الخصوصية</a>
          <a href="/report" class="text-danger">الإبلاغ عن مخالفة</a>
          <a href="mailto:help@zimamak.com" class="support-email"
            >الدعم: help@zimamak.com</a
          >
        </div>
        <p class="copyright">
          &copy; {new Date().getFullYear()} شاغر اليوم. جميع الحقوق محفوظة.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-md);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-primary);
  }

  .nav-link {
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  main {
    min-height: calc(100vh - 140px); /* Adjust based on header/footer heights */
    padding-block: var(--space-xl);
  }

  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-xl);
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .footer-links {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-links .text-danger:hover {
    color: #dc2626;
  }

  .copyright {
    font-size: var(--text-small);
  }
</style>
